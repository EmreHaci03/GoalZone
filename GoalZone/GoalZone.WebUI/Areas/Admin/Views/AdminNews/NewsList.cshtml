@model List<ResultNewsDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section PageHeader{
<div class="page-header">
    <div>
        <h1 class="page-title">
            <span class="accent">HABERLER</span>
        </h1>

        <div class="breadcrumb-custom">
            <a href="/Admin/Dashboard/Index">
                <i class="fa-solid fa-house"></i>
            </a>

            <i class="fa-solid fa-chevron-right" style="font-size: 9px;"></i>

            <span>Haberler</span>
        </div>
    </div>
</div>
}

<div class="news-container">

    <div class="news-header">
        <div>
            <h3>Haber Listesi</h3>
            <span>@Model.Count haber bulundu</span>
        </div>

        <div class="news-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="newsSearch" placeholder="Haber ara...">
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="news-table">

                <thead>
                    <tr>
                        <th>Haber</th>
                        <th>Kategori</th>
                        <th>Takım</th>
                        <th>Yayın Tarihi</th>
                        <th>Görüntülenme</th>
                        <th>Öne Çıkan</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody id="newsTableBody">

                    @foreach (var news in Model)
                    {
                        <tr class="news-row">

                            <td>
                                <div class="news-info">

                                    <img src="@news.ImageUrl"
                                         alt="@news.Title"
                                         class="news-image" />

                                    <div class="news-text">
                                        <div class="news-title">
                                            @news.Title
                                        </div>

                                        <div class="news-description">
                                            @news.ShortDescription.Substring(0,news.ShortDescription.LastIndexOf("."))
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <td>
                                <span class="category-badge">
                                    @news.Category
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(news.RelatedTeamName))
                                {
                                    <div class="team-info">

                                        @if (!string.IsNullOrEmpty(news.RelatedTeamLogo))
                                        {
                                            <img src="@news.RelatedTeamLogo"
                                                 class="team-logo"
                                                 alt="@news.RelatedTeamName" />
                                        }

                                        <span>@news.RelatedTeamName</span>

                                    </div>
                                }
                                else
                                {
                                    <span class="no-team">
                                        Genel
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="date-text">
                                    @news.PublishDate.ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </td>

                            <td>
                                <div class="views">
                                    <i class="fa-solid fa-eye"></i>
                                    @news.ViewCount
                                </div>
                            </td>

                            <td>
                                @if (news.IsFeatured)
                                {
                                    <span class="featured-badge">
                                        <i class="fa-solid fa-star"></i>
                                        Öne Çıkan
                                    </span>
                                }
                                else
                                {
                                    <span class="normal-badge">
                                        Normal
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <a href="/Admin/AdminNews/CreateNews/"
                                       class="action-btn add"
                                       title="Haber Ekle">
                                        <i class="fa-solid fa-plus"></i>
                                    </a>

                                    <a href="/Admin/AdminNews/UpdateNews/@news.NewsId"
                                       class="action-btn edit"
                                       title="Düzenle">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <a href="/Admin/AdminNews/DeleteNews/@news.NewsId"
                                       class="action-btn delete"
                                       title="Sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="empty-news">

            <div class="empty-icon">
                <i class="fa-regular fa-newspaper"></i>
            </div>

            <h3>Henüz haber yok</h3>

            <p>
                Sistemde kayıtlı haber bulunmuyor.
            </p>

            <a href="/Admin/AdminNews/Create" class="btn-quick-add">
                <i class="fa-solid fa-plus"></i>
                İlk Haberi Ekle
            </a>

        </div>
    }

</div>

@section Styles {

    <style>

        .news-container {
            background: var(--dark-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .news-header {
            padding: 22px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            border-bottom: 1px solid var(--border);
        }

            .news-header h3 {
                font-family: 'Bebas Neue', sans-serif;
                font-size: 25px;
                letter-spacing: 1px;
                margin: 0;
            }

            .news-header span {
                color: var(--text-muted);
                font-size: 12px;
            }

        .news-search {
            position: relative;
            width: 280px;
        }

            .news-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 13px;
            }

            .news-search input {
                width: 100%;
                padding: 10px 12px 10px 38px;
                background: var(--dark-bg);
                border: 1px solid var(--border);
                border-radius: 8px;
                color: white;
                outline: none;
            }

                .news-search input:focus {
                    border-color: var(--pl-accent);
                }

        .news-table {
            width: 100%;
            border-collapse: collapse;
        }

            .news-table th {
                padding: 14px 20px;
                text-align: left;
                color: var(--text-muted);
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
                font-weight: 700;
                background: rgba(255,255,255,0.02);
                border-bottom: 1px solid var(--border);
            }

            .news-table td {
                padding: 16px 20px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
                color: var(--text-secondary);
                font-size: 13px;
            }

        .news-row {
            transition: background .2s ease;
        }

            .news-row:hover {
                background: var(--dark-hover);
            }

        .news-info {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 300px;
        }

        .news-image {
            width: 76px;
            height: 52px;
            object-fit: cover;
            border-radius: 7px;
            background: var(--dark-bg);
        }

        .news-title {
            color: white;
            font-weight: 600;
            margin-bottom: 5px;
            max-width: 320px;
        }

        .news-description {
            color: var(--text-muted);
            font-size: 11px;
            max-width: 320px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .category-badge {
            background: rgba(0,255,135,.1);
            color: var(--pl-accent);
            padding: 5px 9px;
            border-radius: 5px;
            font-size: 11px;
            font-weight: 600;
        }

        .team-info {
            display: flex;
            align-items: center;
            gap: 8px;
            color: white;
            white-space: nowrap;
        }

        .team-logo {
            width: 28px;
            height: 28px;
            object-fit: contain;
        }

        .no-team {
            color: var(--text-muted);
        }

        .date-text {
            white-space: nowrap;
        }

        .views {
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .views i {
                color: var(--pl-blue);
            }

        .featured-badge {
            color: #ffd700;
            background: rgba(255,215,0,.1);
            padding: 5px 9px;
            border-radius: 5px;
            font-size: 10px;
            white-space: nowrap;
        }

        .normal-badge {
            color: var(--text-muted);
            background: rgba(255,255,255,.05);
            padding: 5px 9px;
            border-radius: 5px;
            font-size: 10px;
        }

        .action-buttons {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: .2s;
        }

            .action-btn.edit {
                background: rgba(0,255,135,.1);
                color: var(--pl-accent);
            }

            .action-btn.detail {
                background: rgba(4,245,255,.1);
                color: var(--pl-blue);
            }

            .action-btn.delete {
                background: rgba(233,0,82,.1);
                color: var(--pl-pink);
            }

            .action-btn:hover {
                transform: translateY(-2px);
            }

        .empty-news {
            padding: 80px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: rgba(0,255,135,.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--pl-accent);
            font-size: 28px;
        }

        .empty-news h3 {
            color: white;
            margin-bottom: 8px;
        }

        .empty-news p {
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        @@media (max-width: 1000px) {

            .news-header {
                flex-direction: column;
                align-items: stretch;
            }

            .news-search {
                width: 100%;
            }

            .action-btn.add {
                background: rgba(4,245,255,.1);
                color: var(--pl-blue);
            }
        }

    </style>
}

@section Scripts {

    <script>

        const searchInput = document.getElementById("newsSearch");

        if (searchInput) {

            searchInput.addEventListener("input", function () {

                const search = this.value.toLowerCase();

                document.querySelectorAll(".news-row").forEach(row => {

                    const text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(search) ? "" : "none";

                });

            });

        }

    </script>
}