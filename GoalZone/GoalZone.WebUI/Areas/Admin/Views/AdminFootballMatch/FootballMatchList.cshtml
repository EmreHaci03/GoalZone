@model List<ResultFootballMatchDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section PageHeader {
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="accent">MAÇLAR</span>
            </h1>

            <div class="breadcrumb-custom">
                <a href="/Admin/Dashboard/Index">
                    <i class="fa-solid fa-house"></i>
                </a>
                <i class="fa-solid fa-chevron-right" style="font-size: 9px;"></i>
                <span>Maçlar</span>
            </div>
        </div>
    </div>
}

<div class="match-page">

    <div class="match-toolbar">
        <div>
            <h3>Fikstür</h3>
            <span>@Model.Count maç bulundu</span>
        </div>

        <div class="toolbar-actions">
            <div class="match-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="matchSearch" placeholder="Takım ara...">
            </div>

            <a href="/Admin/AdminFootballMatch/CreateFootballMatch/" class="btn-add-match">
                <i class="fa-solid fa-plus"></i>
                Yeni Maç
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var weekGroup in Model.OrderBy(x => x.Week).GroupBy(x => x.Week))
        {
            <div class="week-block">

                <div class="week-header">
                    <span class="week-badge">@weekGroup.Key. HAFTA</span>
                    <div class="week-line"></div>
                </div>

                <div class="match-grid">

                    @foreach (var match in weekGroup)
                    {
                        <div class="match-card">

                            <!-- ÜST: durum + tarih -->
                            <div class="match-top">
                                @{
                                    var statusClass = match.MatchStatus switch
                                    {
                                        "Oynanıyor" => "live",
                                        "Tamamlandı" => "finished",
                                        "Bitti" => "finished",
                                        _ => "scheduled"
                                    };
                                }
                                <span class="status-pill @statusClass">
                                    @if (statusClass == "live")
                                    {
                                        <span class="live-dot"></span>
                                    }
                                    @match.MatchStatus
                                </span>

                                <span class="match-date">
                                    <i class="fa-regular fa-calendar"></i>
                                    @match.MatchDate.ToString("dd MMM, HH:mm")
                                </span>
                            </div>

                            <!-- ORTA: takımlar + skor -->
                            <div class="match-body">

                                <div class="team-side">
                                    <img src="@match.HomeTeamLogoUrl" alt="@match.HomeTeamName" class="team-crest" />
                                    <span class="team-name">@match.HomeTeamName</span>
                                </div>

                                <div class="score-box">
                                    @if (match.FullTimeScoreHome.HasValue && match.FullTimeScoreAway.HasValue)
                                    {
                                        <div class="score-main">
                                            @match.FullTimeScoreHome <span>-</span> @match.FullTimeScoreAway
                                        </div>
                                        @if (match.HalfTimeScoreHome.HasValue && match.HalfTimeScoreAway.HasValue)
                                        {
                                            <div class="score-half">
                                                İY @match.HalfTimeScoreHome-@match.HalfTimeScoreAway
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="score-main vs">VS</div>
                                    }
                                </div>

                                <div class="team-side">
                                    <img src="@match.AwayTeamLogoUrl" alt="@match.AwayTeamName" class="team-crest" />
                                    <span class="team-name">@match.AwayTeamName</span>
                                </div>

                            </div>

                            <!-- ALT: stadyum + aksiyon -->
                            <div class="match-bottom">
                                <span class="stadium">
                                    <i class="fa-solid fa-location-dot"></i>
                                    @match.StadiumName
                                </span>

                                <div class="match-actions">
                                    <a href="/Admin/AdminFootballMatch/UpdateFootballMatch/@match.FootballMatchId"
                                       class="mini-btn edit" title="Düzenle">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a href="/Admin/AdminFootballMatch/DeleteFootballMatch/@match.FootballMatchId"
                                       class="mini-btn delete" title="Sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="empty-match">
            <div class="empty-icon"><i class="fa-solid fa-futbol"></i></div>
            <h3>Henüz maç yok</h3>
            <p>Sistemde kayıtlı maç bulunmuyor.</p>
            <a href="/Admin/AdminFootballMatch/CreateFootballMatch/" class="btn-add-match">
                <i class="fa-solid fa-plus"></i>
                İlk Maçı Ekle
            </a>
        </div>
    }

</div>

@section Styles {
    <style>

        .match-page {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        /* TOOLBAR */
        .match-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            background: var(--dark-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px 24px;
        }

            .match-toolbar h3 {
                font-family: 'Bebas Neue', sans-serif;
                font-size: 25px;
                letter-spacing: 1px;
                margin: 0;
            }

            .match-toolbar span {
                color: var(--text-muted);
                font-size: 12px;
            }

        .toolbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .match-search {
            position: relative;
            width: 240px;
        }

            .match-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 13px;
            }

            .match-search input {
                width: 100%;
                padding: 10px 12px 10px 38px;
                background: var(--dark-bg);
                border: 1px solid var(--border);
                border-radius: 8px;
                color: white;
                outline: none;
            }

                .match-search input:focus {
                    border-color: var(--pl-accent);
                }

        .btn-add-match {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--pl-purple), var(--pl-pink));
            color: white;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            transition: .2s;
        }

            .btn-add-match:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(233,0,82,.3);
                color: white;
            }

        /* HAFTA */
        .week-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }

        .week-badge {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 16px;
            letter-spacing: 2px;
            color: var(--pl-accent);
            background: rgba(0,255,135,.08);
            padding: 6px 14px;
            border-radius: 6px;
            white-space: nowrap;
        }

        .week-line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* GRID */
        .match-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 16px;
        }

        /* KART */
        .match-card {
            background: var(--dark-surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            transition: .2s;
        }

            .match-card:hover {
                border-color: rgba(0,255,135,.3);
                transform: translateY(-2px);
            }

        .match-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .status-pill {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 4px 10px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .status-pill.scheduled {
                background: rgba(4,245,255,.1);
                color: var(--pl-blue);
            }

            .status-pill.live {
                background: rgba(233,0,82,.12);
                color: var(--pl-pink);
            }

            .status-pill.finished {
                background: rgba(255,255,255,.06);
                color: var(--text-muted);
            }

        .live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--pl-pink);
            animation: pulse 1.2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .3;
            }
        }

        .match-date {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* GÖVDE */
        .match-body {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .team-side {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-align: center;
        }

        .team-crest {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }

        .team-name {
            font-size: 12px;
            font-weight: 600;
            color: white;
            line-height: 1.3;
        }

        .score-box {
            text-align: center;
            min-width: 70px;
        }

        .score-main {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 30px;
            font-weight: 700;
            color: white;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .score-main span {
                color: var(--text-muted);
                font-size: 22px;
            }

            .score-main.vs {
                color: var(--text-muted);
                font-size: 20px;
                letter-spacing: 3px;
            }

        .score-half {
            font-size: 10px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* ALT */
        .match-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 14px;
            border-top: 1px solid var(--border);
        }

        .stadium {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .match-actions {
            display: flex;
            gap: 6px;
        }

        .mini-btn {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 12px;
            transition: .2s;
        }

            .mini-btn.edit {
                background: rgba(0,255,135,.1);
                color: var(--pl-accent);
            }

            .mini-btn.delete {
                background: rgba(233,0,82,.1);
                color: var(--pl-pink);
            }

            .mini-btn:hover {
                transform: translateY(-2px);
            }

        /* BOŞ */
        .empty-match {
            padding: 80px 20px;
            text-align: center;
            background: var(--dark-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .empty-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: rgba(0,255,135,.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--pl-accent);
            font-size: 28px;
        }

        .empty-match h3 {
            color: white;
            margin-bottom: 8px;
        }

        .empty-match p {
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        @@media (max-width: 800px) {
            .match-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .toolbar-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .match-search {
                width: 100%;
            }
        }

    </style>
}

@section Scripts {
    <script>
        const searchInput = document.getElementById("matchSearch");
        if (searchInput) {
            searchInput.addEventListener("input", function () {
                const search = this.value.toLowerCase();
                document.querySelectorAll(".match-card").forEach(card => {
                    const text = card.innerText.toLowerCase();
                    card.style.display = text.includes(search) ? "" : "none";
                });
                // Boş kalan hafta bloklarını gizle
                document.querySelectorAll(".week-block").forEach(block => {
                    const visible = block.querySelectorAll(".match-card:not([style*='display: none'])").length;
                    block.style.display = visible ? "" : "none";
                });
            });
        }
    </script>
}