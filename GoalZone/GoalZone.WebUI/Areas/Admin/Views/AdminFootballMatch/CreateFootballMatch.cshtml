@using GoalZone.EntityLayer.Enums
@model CreateFootballMatchDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section PageHeader {
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <span class="accent">MAÇ</span> EKLE
            </h1>

            <div class="breadcrumb-custom">
                <a href="/Admin/AdminDashboard/Index/">
                    <i class="fa-solid fa-house"></i>
                </a>
                <i class="fa-solid fa-chevron-right" style="font-size: 9px;"></i>
                <span>Maç Yönetimi</span>
                <i class="fa-solid fa-chevron-right" style="font-size: 9px;"></i>
                <span>Maç Ekle</span>
            </div>
        </div>
    </div>
}

<div class="match-create-container">

    <form asp-area="Admin"
          asp-controller="AdminFootballMatch"
          asp-action="CreateFootballMatch"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <!-- SOL TARAF -->
        <div class="match-main">

            <!-- EŞLEŞME -->
            <div class="form-card">

                <div class="form-card-header">
                    <div class="header-icon">
                        <i class="fa-solid fa-futbol"></i>
                    </div>
                    <div>
                        <h3>Eşleşme</h3>
                        <span>Karşılaşacak takımları seç</span>
                    </div>
                </div>

                <div class="matchup">

                    <div class="matchup-team">
                        <label asp-for="HomeTeamId">Ev Sahibi</label>
                        <select asp-for="HomeTeamId"
                                id="homeSelect"
                                class="form-control-custom"
                                asp-items="ViewBag.Teams">
                            <option value="">Seçiniz</option>
                        </select>
                        <span asp-validation-for="HomeTeamId" class="field-error"></span>
                    </div>

                    <div class="matchup-vs">VS</div>

                    <div class="matchup-team">
                        <label asp-for="AwayTeamId">Deplasman</label>
                        <select asp-for="AwayTeamId"
                                id="awaySelect"
                                class="form-control-custom"
                                asp-items="ViewBag.Teams">
                            <option value="">Seçiniz</option>
                        </select>
                        <span asp-validation-for="AwayTeamId" class="field-error"></span>
                    </div>

                </div>

                <div id="sameTeamWarn" class="inline-warn" style="display:none;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Ev sahibi ve deplasman aynı takım olamaz.
                </div>

            </div>


            <!-- SKORLAR -->
            <div class="form-card">

                <div class="form-card-header">
                    <div class="header-icon pink">
                        <i class="fa-solid fa-hashtag"></i>
                    </div>
                    <div>
                        <h3>Skorlar</h3>
                        <span>Maç oynanmadıysa boş bırak</span>
                    </div>
                </div>

                <div class="score-group">
                    <span class="score-group-title">İlk Yarı</span>
                    <div class="score-inputs">
                        <input asp-for="HalfTimeScoreHome" type="number" min="0" class="form-control-custom score-input" placeholder="0" />
                        <span class="score-dash">-</span>
                        <input asp-for="HalfTimeScoreAway" type="number" min="0" class="form-control-custom score-input" placeholder="0" />
                    </div>
                </div>

                <div class="score-group">
                    <span class="score-group-title">Maç Sonu</span>
                    <div class="score-inputs">
                        <input asp-for="FullTimeScoreHome" type="number" min="0" class="form-control-custom score-input" placeholder="0" />
                        <span class="score-dash">-</span>
                        <input asp-for="FullTimeScoreAway" type="number" min="0" class="form-control-custom score-input" placeholder="0" />
                    </div>
                </div>

            </div>


            <!-- GÖRSEL -->
            <div class="form-card">

                <div class="form-card-header">
                    <div class="header-icon blue">
                        <i class="fa-solid fa-image"></i>
                    </div>
                    <div>
                        <h3>Maç Görseli</h3>
                        <span>Afiş / kapak görseli adresi</span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ImageUrl">Görsel URL</label>
                    <input asp-for="ImageUrl" class="form-control-custom" placeholder="https://..." />
                    <span asp-validation-for="ImageUrl" class="field-error"></span>
                </div>

            </div>

        </div>


        <!-- SAĞ TARAF -->
        <div class="match-sidebar">

            <div class="form-card">

                <div class="form-card-header">
                    <div class="header-icon green">
                        <i class="fa-solid fa-sliders"></i>
                    </div>
                    <div>
                        <h3>Maç Detayları</h3>
                        <span>Zaman ve yer bilgileri</span>
                    </div>
                </div>

                <!-- Hafta -->
                <div class="form-group">
                    <label asp-for="Week">Hafta</label>
                    <input asp-for="Week" type="number" min="1" class="form-control-custom" placeholder="Örn: 1" />
                    <span asp-validation-for="Week" class="field-error"></span>
                </div>

                <!-- Tarih -->
                <div class="form-group">
                    <label asp-for="MatchDate">Maç Tarihi</label>
                    <input asp-for="MatchDate" type="datetime-local" class="form-control-custom" />
                    <span asp-validation-for="MatchDate" class="field-error"></span>
                </div>


                <!-- Durum -->
                <div class="form-group">
                    <label asp-for="MatchStatus">Maç Durumu</label>
                    <select asp-for="MatchStatus" class="form-control-custom"
                            asp-items="Html.GetEnumSelectList<MatchStatus>()">
                        <option value="">Durum seçiniz</option>
                    </select>
                    <span asp-validation-for="MatchStatus" class="field-error"></span>
                </div>

            </div>

            <div class="form-actions">
                <a href="/Admin/AdminFootballMatch/FootballMatchList/" class="btn-cancel">
                    <i class="fa-solid fa-xmark"></i>
                    İptal
                </a>
                <button type="submit" class="btn-submit">
                    <i class="fa-solid fa-plus"></i>
                    Maçı Oluştur
                </button>
            </div>

        </div>

    </form>

</div>


@section Styles {
    <style>

        .match-create-container {
            width: 100%;
        }

            .match-create-container form {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 360px;
                gap: 24px;
                align-items: start;
            }

        .match-main,
        .match-sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .form-card {
            background: var(--dark-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 26px;
        }

        .form-card-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding-bottom: 20px;
            margin-bottom: 22px;
            border-bottom: 1px solid var(--border);
        }

            .form-card-header h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 700;
            }

            .form-card-header span {
                display: block;
                color: var(--text-muted);
                font-size: 12px;
                margin-top: 3px;
            }

        .header-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: rgba(0, 255, 135, .1);
            color: var(--pl-accent);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .header-icon.pink {
                background: rgba(233, 0, 82, .12);
                color: var(--pl-pink);
            }

            .header-icon.blue {
                background: rgba(4, 245, 255, .1);
                color: var(--pl-blue);
            }

            .header-icon.green {
                background: rgba(0, 255, 135, .1);
                color: var(--pl-accent);
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group:last-child {
                margin-bottom: 0;
            }

            .form-group label,
            .matchup-team label {
                display: block;
                color: var(--text-secondary);
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 8px;
            }

        .form-control-custom {
            width: 100%;
            background: var(--dark-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 11px 13px;
            color: white;
            font-size: 13px;
            outline: none;
            transition: .2s;
        }

            .form-control-custom:focus {
                border-color: var(--pl-accent);
                box-shadow: 0 0 0 3px rgba(0,255,135,.07);
            }

        /* EŞLEŞME */
        .matchup {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: end;
            gap: 16px;
        }

        .matchup-vs {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 20px;
            color: var(--text-muted);
            letter-spacing: 2px;
            padding-bottom: 11px;
        }

        .inline-warn {
            margin-top: 14px;
            padding: 10px 14px;
            background: rgba(233,0,82,.1);
            border: 1px solid rgba(233,0,82,.3);
            border-radius: 8px;
            color: var(--pl-pink);
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* SKOR */
        .score-group {
            margin-bottom: 18px;
        }

            .score-group:last-child {
                margin-bottom: 0;
            }

        .score-group-title {
            display: block;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .score-inputs {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .score-input {
            width: 70px;
            text-align: center;
            font-size: 18px;
            font-weight: 700;
        }

        .score-dash {
            color: var(--text-muted);
            font-size: 20px;
            font-weight: 700;
        }

        .form-help {
            display: block;
            color: var(--text-muted);
            font-size: 11px;
            margin-top: 6px;
        }

        .field-error {
            display: block;
            color: #ff4d6d;
            font-size: 11px;
            margin-top: 5px;
        }

        .validation-summary {
            color: #ff4d6d;
            margin-bottom: 15px;
        }

        .form-actions {
            display: flex;
            gap: 10px;
        }

        .btn-cancel, .btn-submit {
            flex: 1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }

        .btn-cancel {
            background: var(--dark-surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
        }

            .btn-cancel:hover {
                color: white;
                background: var(--dark-hover);
            }

        .btn-submit {
            border: none;
            color: white;
            background: linear-gradient(135deg, var(--pl-purple), var(--pl-pink));
        }

            .btn-submit:hover {
                color: white;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(233,0,82,.3);
            }

        @@media(max-width: 1000px) {
            .match-create-container form {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width: 500px) {
            .matchup {
                grid-template-columns: 1fr;
            }

            .matchup-vs {
                padding: 4px 0;
                text-align: center;
            }
        }

    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Ev sahibi = deplasman kontrolü
        const home = document.getElementById("homeSelect");
        const away = document.getElementById("awaySelect");
        const warn = document.getElementById("sameTeamWarn");

        function checkSameTeam() {
            if (home.value && away.value && home.value === away.value) {
                warn.style.display = "flex";
            } else {
                warn.style.display = "none";
            }
        }

        if (home && away) {
            home.addEventListener("change", checkSameTeam);
            away.addEventListener("change", checkSameTeam);
        }
    </script>
}