@model List<ResultFootballMatchDto>

@{
    Layout = "~/Views/Shared/_UILayout.cshtml";
    var allWeeks = ViewBag.AllWeeks as List<int> ?? new List<int>();
    int selectedWeek = ViewBag.SelectedWeek ?? 1;

    var firstMatch = Model != null && Model.Any()
        ? Model.OrderBy(x => x.MatchDate).First()
        : null;
}

<style>
    .fx-page-head {
        background: linear-gradient(135deg, var(--bg2, #0c1220), var(--card, #111827));
        border-bottom: 1px solid var(--border, #1a2640);
        padding: 32px 0 24px;
    }

    .fx-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,214,0,.09);
        border: 1px solid rgba(255,214,0,.22);
        border-radius: 20px;
        padding: 4px 12px;
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: var(--gold, #ffd600);
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .fx-title {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: clamp(26px, 5vw, 42px);
        font-weight: 900;
        letter-spacing: .5px;
        line-height: 1;
        color: var(--t1, #eef2ff);
    }

    .fx-sub {
        font-size: 13px;
        color: var(--t2, #7b96c4);
        margin-top: 6px;
    }

    .wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* HAFTA BUTONLARI */
    .week-nav-scroll {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding: 20px 0 6px;
        scrollbar-width: thin;
    }

    .week-btn {
        flex-shrink: 0;
        padding: 9px 18px;
        background: var(--card, #111827);
        border: 1px solid var(--border, #1a2640);
        border-radius: 8px;
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .5px;
        color: var(--t2, #7b96c4);
        white-space: nowrap;
        transition: all .2s;
        text-decoration: none;
    }

        .week-btn:hover {
            background: var(--elevated, #1c2d42);
            color: var(--t1, #eef2ff);
            border-color: var(--blue, #2979ff);
        }

        .week-btn.active {
            background: linear-gradient(135deg, var(--green, #00e676), var(--blue, #2979ff));
            border-color: transparent;
            color: #fff;
        }

    .fx-content {
        padding: 24px 0 56px;
    }

    /* MAÇ KARTI */
    .fx-card {
        background: var(--card, #111827);
        border: 1px solid var(--border, #1a2640);
        border-radius: 12px;
        margin-bottom: 8px;
        overflow: hidden;
        transition: all .2s;
    }

        .fx-card:hover {
            background: var(--card2, #16202f);
            border-color: rgba(41,121,255,.3);
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(0,0,0,.4);
        }

    .fx-inner {
        display: flex;
        align-items: center;
        padding: 14px 18px;
    }

    .fx-time-col {
        width: 72px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .fx-time {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 16px;
        font-weight: 700;
        color: var(--t2, #7b96c4);
    }

    .fx-day-label {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: var(--t3, #3d5478);
    }

    .fx-divider {
        width: 1px;
        height: 44px;
        background: var(--border, #1a2640);
        margin: 0 16px;
        flex-shrink: 0;
    }

    .fx-teams {
        flex: 1;
        min-width: 0;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 8px;
    }

    .fx-team-home {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: flex-end;
    }

    .fx-team-away {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fx-name {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 16px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--t1, #eef2ff);
    }

        .fx-name.home {
            text-align: right;
        }

    .fx-logo {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--elevated, #1c2d42);
        border: 1px solid var(--border, #1a2640);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

        .fx-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 3px;
        }

    .vs-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        flex-shrink: 0;
        min-width: 60px;
    }

    .vs-text {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 18px;
        font-weight: 800;
        color: var(--t1, #eef2ff);
    }

        .vs-text.novs {
            font-size: 13px;
            color: var(--t3, #3d5478);
        }

    .vs-time-sm {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 10px;
        color: var(--t3, #3d5478);
    }

    .fx-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        margin-left: 14px;
        flex-shrink: 0;
    }

    .fx-stadium {
        font-size: 11px;
        color: var(--t3, #3d5478);
        text-align: right;
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* DURUM ETİKETİ — duruma göre renklenir */
    .fx-status-tag {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .status-live-tag {
        color: #ff2e63;
        background: rgba(233,0,82,.12);
    }

    .status-finished-tag {
        color: var(--green, #00e676);
        background: rgba(0,230,118,.1);
    }

    .status-notstarted-tag {
        color: var(--t3, #3d5478);
        background: rgba(123,150,196,.08);
    }

    .live-dot-sm {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #ff2e63;
        animation: pulseLive 1.2s infinite;
    }

    .fx-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--t2, #7b96c4);
    }

        .fx-empty i {
            font-size: 40px;
            color: var(--t3, #3d5478);
        }

    /* SAĞ ÜST: GERİ SAYIM / DURUM */
    .countdown-strip {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: rgba(41,121,255,.06);
        border: 1px solid rgba(41,121,255,.15);
        border-radius: 12px;
        padding: 12px 20px;
        flex-wrap: wrap;
    }

    .cd-label {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--t3, #3d5478);
    }

    .cd-box {
        background: var(--elevated, #1c2d42);
        border-radius: 8px;
        padding: 6px 14px;
        text-align: center;
    }

    .cd-num {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 22px;
        font-weight: 900;
        color: var(--blue, #2979ff);
        line-height: 1;
    }

    .cd-unit {
        font-size: 9px;
        color: var(--t3, #3d5478);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 2px;
    }

    .cd-sep {
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-size: 22px;
        font-weight: 900;
        color: var(--t3, #3d5478);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 12px;
        font-family: var(--fd, 'Barlow Condensed', sans-serif);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: .5px;
    }

    .status-finished {
        background: rgba(123,150,196,.1);
        border: 1px solid rgba(123,150,196,.2);
        color: var(--t2, #7b96c4);
    }

    .status-live {
        background: rgba(233,0,82,.12);
        border: 1px solid rgba(233,0,82,.3);
        color: #ff2e63;
    }

    .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ff2e63;
        animation: pulseLive 1.2s infinite;
    }

    @@keyframes pulseLive {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .3;
        }
    }

    @@media(max-width:768px) {
        .fx-right .fx-stadium {
            display: none;
        }

        .fx-name {
            font-size: 13px;
        }
    }

    @@media(max-width:500px) {
        .fx-name {
            font-size: 12px;
        }

        .fx-logo {
            width: 24px;
            height: 24px;
        }
    }
</style>

<!-- PAGE HEADER -->
<section class="fx-page-head">
    <div class="wrap">
        <div class="row align-items-end">

            <div class="col-lg-7">
                <div class="fx-badge"><i class="bi bi-trophy-fill"></i> Premier League</div>
                <h1 class="fx-title">Hafta <span style="color:var(--blue,#2979ff)">@selectedWeek</span> Fikstürü</h1>
                <p class="fx-sub">@Model.Count maç</p>
            </div>

            <div class="col-lg-5 mt-3 mt-lg-0">
                @if (firstMatch != null)
                {
                    if (firstMatch.MatchStatus == "Finished")
                    {
                        <div class="status-pill status-finished">
                            <i class="bi bi-check2-circle"></i> Bu Hafta Tamamlandı
                        </div>
                    }
                    else if (firstMatch.MatchStatus == "Live")
                    {
                        <div class="status-pill status-live">
                            <span class="live-dot"></span> Şu An Canlı
                        </div>
                    }
                    else
                    {
                        <div class="countdown-strip" id="countdownBox"
                             data-target="@firstMatch.MatchDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                            <span class="cd-label">İlk Maça</span>
                            <div class="cd-box"><div class="cd-num" id="cd-d">--</div><div class="cd-unit">Gün</div></div>
                            <span class="cd-sep">:</span>
                            <div class="cd-box"><div class="cd-num" id="cd-h">--</div><div class="cd-unit">Saat</div></div>
                            <span class="cd-sep">:</span>
                            <div class="cd-box"><div class="cd-num" id="cd-m">--</div><div class="cd-unit">Dakika</div></div>
                            <span class="cd-sep">:</span>
                            <div class="cd-box"><div class="cd-num" id="cd-s">--</div><div class="cd-unit">Saniye</div></div>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</section>

<!-- HAFTA BUTONLARI -->
<div class="wrap">
    <div class="week-nav-scroll">
        @foreach (var w in allWeeks)
        {
            <a href="/Fixture/Index?week=@w"
               class="week-btn @(w == selectedWeek ? "active" : "")">
                @w. Hafta
            </a>
        }
    </div>
</div>

<!-- MAÇLAR -->
<main>
    <div class="wrap">
        <div class="fx-content">

            @if (Model != null && Model.Any())
            {
                @foreach (var match in Model)
                {
                    var statusClass = match.MatchStatus switch
                    {
                        "Live" => "status-live-tag",
                        "Finished" => "status-finished-tag",
                        _ => "status-notstarted-tag"
                    };

                    var statusText = match.MatchStatus switch
                    {
                        "Live" => "Canlı",
                        "Finished" => "Tamamlandı",
                        "NotStarted" => "Başlamadı",
                        _ => match.MatchStatus
                    };

                    <div class="fx-card">
                        <div class="fx-inner">

                            <div class="fx-time-col">
                                <div class="fx-time">@match.MatchDate.ToString("HH:mm")</div>
                                <div class="fx-day-label">@match.MatchDate.ToString("dd MMM")</div>
                            </div>

                            <div class="fx-divider"></div>

                            <div class="fx-teams">
                                <div class="fx-team-home">
                                    <span class="fx-name home">@match.HomeTeamName</span>
                                    <div class="fx-logo">
                                        <img src="@match.HomeTeamLogoUrl" alt="@match.HomeTeamName"
                                             onerror="this.style.display='none'" />
                                    </div>
                                </div>

                                <div class="vs-block">
                                    @if (match.FullTimeScoreHome.HasValue && match.FullTimeScoreAway.HasValue)
                                    {
                                        <span class="vs-text">@match.FullTimeScoreHome–@match.FullTimeScoreAway</span>
                                        @if (match.HalfTimeScoreHome.HasValue && match.HalfTimeScoreAway.HasValue)
                                        {
                                            <span class="vs-time-sm">İY @match.HalfTimeScoreHome-@match.HalfTimeScoreAway</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="vs-text novs">VS</span>
                                        <span class="vs-time-sm">@match.MatchDate.ToString("HH:mm")</span>
                                    }
                                </div>

                                <div class="fx-team-away">
                                    <div class="fx-logo">
                                        <img src="@match.AwayTeamLogoUrl" alt="@match.AwayTeamName"
                                             onerror="this.style.display='none'" />
                                    </div>
                                    <span class="fx-name">@match.AwayTeamName</span>
                                </div>
                            </div>

                            <div class="fx-right">
                                <span class="fx-stadium">
                                    <i class="bi bi-geo-alt" style="font-size:10px;margin-right:3px"></i>@match.StadiumName
                                </span>
                                <span class="fx-status-tag @statusClass">
                                    @if (match.MatchStatus == "Live")
                                    {
                                        <span class="live-dot-sm"></span>
                                    }
                                    @statusText
                                </span>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="fx-empty">
                    <i class="bi bi-calendar-x"></i>
                    <p style="margin-top:14px">Bu haftaya ait maç bulunamadı.</p>
                </div>
            }

        </div>
    </div>
</main>

<script>
    (function () {
        var box = document.getElementById('countdownBox');
        if (!box) return;

        var target = new Date(box.getAttribute('data-target'));

        function update() {
            var now = new Date();
            var diff = target - now;

            if (diff <= 0) {
                document.getElementById('cd-d').textContent = '00';
                document.getElementById('cd-h').textContent = '00';
                document.getElementById('cd-m').textContent = '00';
                document.getElementById('cd-s').textContent = '00';
                return;
            }

            var d = Math.floor(diff / 86400000);
            var h = Math.floor((diff % 86400000) / 3600000);
            var m = Math.floor((diff % 3600000) / 60000);
            var s = Math.floor((diff % 60000) / 1000);

            document.getElementById('cd-d').textContent = String(d).padStart(2, '0');
            document.getElementById('cd-h').textContent = String(h).padStart(2, '0');
            document.getElementById('cd-m').textContent = String(m).padStart(2, '0');
            document.getElementById('cd-s').textContent = String(s).padStart(2, '0');
        }

        update();
        setInterval(update, 1000);
    })();
</script>
