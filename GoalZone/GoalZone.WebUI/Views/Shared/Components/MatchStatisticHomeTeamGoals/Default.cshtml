@model List<GetMatchEventByFootballIdDto>

<div class="box2">
    <div class="box2-title">⚽ @ViewBag.HomeTeam  </div>

    @if (Model != null && Model.Any())
    {
        foreach (var goal in Model)
        {
            <div class="gl">
                <div class="gl-ico">⚽</div>

                <div class="gl-pl">
                    @goal.PlayerName
                </div>

                <div class="gl-min">
                    @goal.Minute'
                </div>
            </div>
        }
    }
    else
    {
        <div class="gl">
            <div class="gl-pl" style="color:var(--t2)">
                Gol yok
            </div>
        </div>
    }
</div>