@model List<ResultFootballMatchDto>

@{
    var items = Model ?? new List<ResultFootballMatchDto>();
}

<div class="recent-matches">
    @if (items.Any())
    {
        @foreach (var item in items.Take(5))
        {
            <div class="recent-match">
                <div class="recent-match-info">
                    <span class="match-status finished">
                        @item.MatchStatus
                    </span>
                    <span class="recent-date">
                        @item.MatchDate.ToString("dd MMM yyyy")
                    </span>
                </div>
                <div class="recent-match-teams">
                    <div class="recent-team">
                        <span>@item.HomeTeamName</span>
                        <div class="recent-logo">
                            <img src="@item.HomeTeamLogoUrl" alt="@item.HomeTeamName"
                                 onerror="this.style.display='none'" />
                        </div>
                    </div>
                    <div class="recent-score">
                        <strong>@item.FullTimeScoreHome</strong>
                        <span>-</span>
                        <strong>@item.FullTimeScoreAway</strong>
                    </div>
                    <div class="recent-team away">
                        <div class="recent-logo">
                            <img src="@item.AwayTeamLogoUrl" alt="@item.AwayTeamName"
                                 onerror="this.style.display='none'" />
                        </div>
                        <span>@item.AwayTeamName</span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p style="text-align:center; color:var(--t3, #888); padding: 20px;">
            Henüz maç bulunmuyor.
        </p>
    }
</div>

<style>
    .recent-logo {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--elevated, #1c2d42);
        border: 1px solid var(--border, #1a2640);
        flex-shrink: 0;
    }

        .recent-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 4px;
            display: block;
        }
</style>