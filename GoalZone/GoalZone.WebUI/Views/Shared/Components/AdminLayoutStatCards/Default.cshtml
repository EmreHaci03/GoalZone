<div class="stats-row">
    <div class="stat-card">
        <div>
            <div class="stat-info-label">Toplam Maç</div>
            <div class="stat-info-value">@ViewBag.TotalMatch</div>
            <div class="stat-info-trend"><i class="fa-solid fa-arrow-up"></i> Bu hafta +10</div>
        </div>
        <div class="stat-icon purple">
            <i class="fa-solid fa-futbol"></i>
        </div>
    </div>

    <div class="stat-card">
        <div>
            <div class="stat-info-label">Maç Olayları</div>
            <div class="stat-info-value">@ViewBag.TotalMatchEvent</div>
            <div class="stat-info-trend"><i class="fa-solid fa-arrow-up"></i> +84 yeni</div>
        </div>
        <div class="stat-icon pink">
            <i class="fa-solid fa-flag"></i>
        </div>
    </div>

    <div class="stat-card">
        <div>
            <div class="stat-info-label">İstatistikler</div>
            <div class="stat-info-value">@ViewBag.TotalMatchStatistic</div>
            <div class="stat-info-trend"><i class="fa-solid fa-arrow-up"></i> Güncel</div>
        </div>
        <div class="stat-icon green">
            <i class="fa-solid fa-chart-simple"></i>
        </div>
    </div>

    <div class="stat-card">
        <div>
            <div class="stat-info-label">Aktif Takım</div>
            <div class="stat-info-value">@ViewBag.TotalTeam</div>
            <div class="stat-info-trend"><i class="fa-solid fa-check"></i> Tam kadro</div>
        </div>
        <div class="stat-icon blue">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
    </div>
</div>