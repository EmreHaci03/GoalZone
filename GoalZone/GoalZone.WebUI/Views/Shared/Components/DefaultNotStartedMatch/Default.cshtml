@model List<ResultFootballMatchDto>

@foreach (var item in Model)
{
    <div class="mc-wrap mcw" data-s="upcoming">
        <a href="#" class="mc">

            <div class="mc-time">
                <div class="mc-min bc">
                    @item.MatchDate.ToString("HH:mm")
                </div>

                <div class="sbadge sb-up">
                    @if (item.MatchDate.Date == DateTime.Today)
                    {
                        @:BUGÜN
                    }
                    else if (item.MatchDate.Date == DateTime.Today.AddDays(1))
                    {
                        @:YARIN
                    }
                    else
                    {
                        @item.MatchDate.ToString("dd MMM")
                    }
                </div>
            </div>

            <div class="dvv"></div>

            <div class="mc-teams">

                <!-- HOME -->
                <div class="mc-tr">
                    <div class="tl-sm">
                        <img src="@item.HomeTeamLogoUrl"
                             alt="@item.HomeTeamName"
                             onerror="this.parentNode.textContent='@item.HomeTeamName'" />
                    </div>

                    <span class="tn">
                        @item.HomeTeamName
                    </span>

                    <span class="ts dim">—</span>
                </div>

                <!-- AWAY -->
                <div class="mc-tr">
                    <div class="tl-sm">
                        <img src="@item.AwayTeamLogoUrl"
                             alt="@item.AwayTeamName"
                             onerror="this.parentNode.textContent='@item.AwayTeamName'" />
                    </div>

                    <span class="tn">
                        @item.AwayTeamName
                    </span>

                    <span class="ts dim">—</span>
                </div>

            </div>

            <span class="det-btn">
                <i class="bi bi-calendar-check"></i>
                <span>Fikstür</span>
            </span>

        </a>
    </div>
}