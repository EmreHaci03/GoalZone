@model List<ResultLiveMatchDto>

@foreach (var item in Model)
{
    <div class="mc-wrap mcw" data-s="live">
        <div class="mc live lp">

            <div class="mc-time">
                <div class="mc-min lc">
                    @item.MatchDate.ToString("HH:mm")
                </div>

                <div class="sbadge sb-live">
                    <span class="live-dot"></span>CANLI
                </div>
            </div>

            <div class="dvv"></div>

            <div class="mc-teams">

                <!-- HOME -->
                <div class="mc-tr">
                    <div class="tl-sm">
                        <img src="@item.HomeTeamLogoUrl"
                             alt="@item.HomeTeamName"
                             onerror="this.parentNode.textContent='@item.HomeTeamName'" />
                    </div>

                    <span class="tn">@item.HomeTeamName</span>

                    <span class="ts">
                        @(item.FullTimeScoreHome ?? 0)
                    </span>
                </div>

                <!-- AWAY -->
                <div class="mc-tr">
                    <div class="tl-sm">
                        <img src="@item.AwayTeamLogoUrl"
                             alt="@item.AwayTeamName"
                             onerror="this.parentNode.textContent='@item.AwayTeamName'" />
                    </div>

                    <span class="tn">@item.AwayTeamName</span>

                    <span class="ts">
                        @(item.FullTimeScoreAway ?? 0)
                    </span>
                </div>

            </div>

            <a href="/MatchDetail/Index?FootballMatchId=@item.FootballMatchId"
               class="det-btn">
                <i class="bi bi-chevron-right"></i>
                <span>Detay</span>
            </a>

        </div>
    </div>
}